# Copy to .env and fill in the real password. Never commit .env.

# ---------------------------------------------------------------- database
# MongoDB Atlas connection string for the Work Flow cluster.
# Password must be URL-encoded: @ -> %40, / -> %2F, : -> %3A, # -> %23
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.s7kcclp.mongodb.net/?appName=Cluster0

# ------------------------------------------------------------------- server
NODE_ENV=development
# Must match VITE_API_BASE_URL in frontend/.env.
PORT=5001
# Comma-separated. The Vite dev server proxies /api, so this only matters for
# direct browser calls to the API.
# Leave this UNSET in development: with no value, any loopback port is accepted,
# so a dev server that shifted off 5173 (because the port was busy) still works.
# Setting it turns the strict list above back on, and is required in production.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------------- auth
# Two independent JWT realms: the employee dashboard and the platform admin
# area must never accept each other's tokens. Change both before deploying.
JWT_EMPLOYEE_SECRET=dev-employee-secret-change-me
JWT_PLATFORM_SECRET=dev-platform-secret-change-me
JWT_EXPIRES_IN=7d
JWT_PLATFORM_EXPIRES_IN=7d

# ------------------------------------------------------------------ uploads
# Cloudflare R2 (S3-compatible). Leave these blank to fall back to serving files
# from backend/uploads — useful locally, not for production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional; derived from R2_ACCOUNT_ID when blank.
R2_ENDPOINT=

UPLOAD_MAX_BYTES=2097152
UPLOAD_SIGNED_URL_TTL=300
UPLOAD_LOCAL_DIR=
# Base URL the browser uses to reach the local fallback store. Blank means
# http://localhost:$PORT.
UPLOAD_LOCAL_BASE_URL=

# -------------------------------------------------------------------- seed
# Seeds a demo manager + 4 employees on boot when the employees collection is
# empty, so a fresh database is immediately usable.
SEED_ON_START=true
SEED_MANAGER_PASSWORD=Manager@123
SEED_EMPLOYEE_PASSWORD=Employee@123

# The platform administrator is a separate account from the team manager.
# Only role="admin" can sign in at /admin/login or reach /api/admin; the
# manager role cannot. The admin is ensured on every boot, so this account
# exists even on a database seeded before the admin role did.
SEED_ADMIN_EMAIL=admin@learnilm.test
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Platform Administrator